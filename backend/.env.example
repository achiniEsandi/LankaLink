PORT=5000
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Ask the team lead for your own database user.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Database inside the cluster (defaults to lankalink)
MONGO_DB=lankalink
CLIENT_URL=http://localhost:5173
# Any long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste-a-long-random-string-here
JWT_EXPIRES_IN=7d

# Email (password reset, later notifications). Leave SMTP_HOST empty to print emails to the log instead.
# Gmail: smtp.gmail.com, port 587, your address, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LankaLink <no-reply@lankalink.lk>
