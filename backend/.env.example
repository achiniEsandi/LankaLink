PORT=5000
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Ask the team lead for your own database user.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Database inside the cluster (defaults to lankalink)
MONGO_DB=lankalink
CLIENT_URL=http://localhost:5173
# Any long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste-a-long-random-string-here
JWT_EXPIRES_IN=7d
# Email (verification links). Free Brevo account: Settings > SMTP & API > API keys, and verify EMAIL_FROM as a sender.
# Leave BREVO_API_KEY empty in development: links are printed in the backend terminal instead.
BREVO_API_KEY=
EMAIL_FROM=your-verified-sender@gmail.com
EMAIL_FROM_NAME=LankaLink
