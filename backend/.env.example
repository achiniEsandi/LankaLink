PORT=5000
MONGO_URI=mongodb://localhost:27017/lankalink
CLIENT_URL=http://localhost:5173
# Any long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Email (password reset, later notifications). Leave SMTP_HOST empty to print emails to the log instead.
# Gmail: smtp.gmail.com, port 587, your address, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LankaLink <no-reply@lankalink.lk>
